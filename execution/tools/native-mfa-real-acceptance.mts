import assert from "node:assert/strict";
import {createHash, createHmac, randomUUID} from "node:crypto";
import {execFileSync} from "node:child_process";
import {readFileSync, writeFileSync, existsSync, statSync} from "node:fs";
import {createRequire} from "node:module";
import {runInNewContext} from "node:vm";
import {createSyncStudioStarter, createSyncStudioDocument} from "../../packages/studio/src/sync";

async function run() {
 assert.equal(process.env.VEYOCAST_S227_LOCAL_ACCEPTANCE,"1");
 assert.equal(process.cwd(),"/home/codex/repos/castivo-s227");
 const checkpointPath="/tmp/veyocast-s227-native-mfa-checkpoint.json";
 const configPath="/home/codex/.local/state/veyocast-s226/local-status.json";
 assert.equal(statSync(configPath).mode & 0o777,0o600);
 const config=JSON.parse(readFileSync(configPath,"utf8"));
 assert.equal(config.API_URL,"http://127.0.0.1:57621");
 const container="supabase_db_veyocast-s226";
 assert.equal(execFileSync("docker",["inspect","--format",'{{.Name}} {{index .Config.Labels "com.supabase.cli.project"}}',container],{encoding:"utf8",stdio:["ignore","pipe","pipe"]}).trim(),`/${container} veyocast-s226`);
 const userId="19170000-0000-4000-8000-000000000001",tenantId="19170000-0000-4000-8000-000000000010";
 const require=createRequire(`${process.cwd()}/apps/control/package.json`);
 const {createClient}=require("@supabase/supabase-js");
 const client=createClient(config.API_URL,config.ANON_KEY,{auth:{persistSession:false,autoRefreshToken:false,detectSessionInUrl:false},global:{fetch(input:RequestInfo|URL,init?:RequestInit){const target=new URL(typeof input==="string"?input:input instanceof URL?input.href:input.url);assert.equal(target.origin,config.API_URL);return fetch(input,{...init,signal:AbortSignal.timeout(30000)});}}});
 const signIn=await client.auth.signInWithPassword({email:"sites-qa@veyocast.test",password:"veyocast-local"});
 assert.ok(!signIn.error&&signIn.data.user?.id===userId,"Owned local sign-in failed");
 const rootRequire=createRequire(`${process.cwd()}/package.json`);
 const {build}=rootRequire(rootRequire.resolve("esbuild",{paths:[rootRequire.resolve("tsx")]}));
 const bundle=await build({entryPoints:["apps/control-mobile/src/auth/mfa.ts"],bundle:true,write:false,platform:"node",format:"cjs",plugins:[{name:"real-local-auth-client",setup(builder:any){builder.onResolve({filter:/^\.\/supabase$/},(args:any)=>args.importer.endsWith("/auth/mfa.ts")?{path:"real-client",namespace:"local-auth"}:null);builder.onLoad({filter:/.*/,namespace:"local-auth"},()=>({contents:"export const mobileSupabase=globalThis.__ownedLocalAuthClient;",loader:"js"}));}}]});
 const sandbox:any={module:{exports:{}},exports:{},__ownedLocalAuthClient:client};sandbox.exports=sandbox.module.exports;
 runInNewContext(bundle.outputFiles[0].text,sandbox,{timeout:10000});
 const controller=sandbox.module.exports;
 const before=await controller.readNativeMfa(userId);
 assert.equal(before.currentLevel,"aal1");assert.equal(before.verified.length,1);
 const factorId=before.verified[0].id;
 assert.match(factorId,/^[a-f0-9-]{36}$/);
 const factor=JSON.parse(execFileSync("docker",["exec",container,"psql","-U","postgres","-d","postgres","-Atc",`select json_build_object('id',id,'secret',secret) from auth.mfa_factors where user_id='${userId}' and id='${factorId}' and status='verified' and factor_type='totp';`],{encoding:"utf8",stdio:["ignore","pipe","pipe"]}).trim());
 assert.ok(factor.id===factorId&&/^[A-Z2-7]{16,128}$/.test(factor.secret),"Owned local factor mismatch");
 const presentation=createSyncStudioStarter({family:"club-story",tenantName:"Lokale native MFA-proef"}).syncPresentation!;
 presentation.name=`S227 native MFA ${randomUUID()}`;
 const document=createSyncStudioDocument(presentation,3,false);
 const existed=existsSync(checkpointPath);
 const checkpoint=existed?JSON.parse(readFileSync(checkpointPath,"utf8")):{command:{operation:"create",document,idempotencyKey:randomUUID()}};
 assert.ok(!checkpoint.completed,"Completed acceptance is single-use");
 if(existed)assert.equal(process.env.VEYOCAST_S227_RESUME,"1");
 const persist=()=>writeFileSync(checkpointPath,JSON.stringify(checkpoint),{mode:0o600});persist();
 async function post(){const token=(await client.auth.getSession()).data.session?.access_token;assert.ok(typeof token==="string");const response=await fetch("http://127.0.0.1:3250/api/mobile/v3/studio",{method:"POST",headers:{Authorization:`Bearer ${token}`,"X-VeyoCast-Tenant-Id":tenantId,"Content-Type":"application/json"},body:JSON.stringify(checkpoint.command),signal:AbortSignal.timeout(60000)});return {status:response.status,body:await response.json()};}
 const denied=await post();assert.equal(denied.status,403);
 const alphabet="ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";let bits="";for(const c of factor.secret)bits+=alphabet.indexOf(c).toString(2).padStart(5,"0");
 const secret=Buffer.from(Array.from({length:Math.floor(bits.length/8)},(_,i)=>Number.parseInt(bits.slice(i*8,i*8+8),2)));
 const counter=Buffer.alloc(8);counter.writeBigUInt64BE(BigInt(Math.floor(Date.now()/30000)));const digest=createHmac("sha1",secret).update(counter).digest();const offset=digest[digest.length-1]!&15;const code=String((digest.readUInt32BE(offset)&0x7fffffff)%1000000).padStart(6,"0");
 const verified=await controller.verifyNativeTotp(userId,factorId,code);assert.equal(verified.currentLevel,"aal2");
 const confirmed=await post();assert.equal(confirmed.status,200);assert.equal(confirmed.body.data.outcome,"created");
 checkpoint.projectId??=confirmed.body.data.projectId;assert.equal(confirmed.body.data.projectId,checkpoint.projectId);persist();
 const replay=await post();assert.equal(replay.status,200);assert.equal(replay.body.data.projectId,checkpoint.projectId);
 const currentFactors=await client.auth.mfa.listFactors();assert.ok(!currentFactors.error);assert.equal(currentFactors.data.all.length,before.verified.length+before.unverified.length);
 const files=["apps/control-mobile/src/auth/mfa.ts","apps/control-mobile/src/auth/session-operations.ts"];
 const evidence={status:"PASS",checkedAt:new Date().toISOString(),scope:"Compiled actual native MFA controller and real Supabase SDK/Auth/PostgreSQL/V3 HTTP; factory replaced solely by owned local memory client. No installed app, SecureStore or hardware UI claim.",passwordAssurance:before.currentLevel,writeBeforeMfa:denied.status,authenticatorAssurance:verified.currentLevel,writeAfterMfa:confirmed.status,sameCreateCommandReused:true,sameNonceReplayProjectUnchanged:true,projectId:checkpoint.projectId,noFactorEnrolledOrRemoved:true,sources:files.map(path=>({path,sha256:createHash("sha256").update(readFileSync(path)).digest("hex")}))};
 writeFileSync("execution/evidence/native-mfa-real-services.json",JSON.stringify(evidence,null,2)+"\n");checkpoint.completed=true;persist();process.stdout.write(JSON.stringify(evidence)+"\n");
}
run().catch(()=>{process.stderr.write("LOCAL_NATIVE_MFA_ACCEPTANCE_FAILED; protected checkpoint retained; no secret output\n");process.exitCode=1;});
