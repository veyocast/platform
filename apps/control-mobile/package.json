{
  "name": "@veyocast/control-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "build": "expo export --platform android --output-dir dist --source-maps external",
    "prebuild:android": "expo prebuild --clean --platform android --no-install",
    "bundle:android": "pnpm prebuild:android && ./android/gradlew -p android app:bundleRelease --no-daemon",
    "config:validate": "tsx scripts/validate-config.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo-google-fonts/roboto": "0.4.2",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.110.7",
    "@tanstack/react-query": "5.101.4",
    "@veyocast/auth": "workspace:*",
    "@veyocast/contracts": "workspace:*",
    "@veyocast/domain": "workspace:*",
    "@veyocast/mobile-design-system": "workspace:*",
    "expo": "~57.0.11",
    "expo-application": "~57.0.2",
    "expo-build-properties": "~57.0.9",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "~57.0.8",
    "expo-linking": "~57.0.5",
    "expo-local-authentication": "~57.0.2",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.9",
    "expo-router": "~57.0.11",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "lucide-react-native": "1.27.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.83.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@expo/config": "57.0.6",
    "@expo/config-plugins": "57.0.6",
    "@testing-library/react-native": "14.0.1",
    "@types/react": "~19.2.2",
    "react-test-renderer": "19.2.3"
  }
