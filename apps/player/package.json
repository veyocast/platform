{
  "name": "@veyocast/player",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "browserslist": [
    "chrome 79"
  ],
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build && node ../../scripts/assert-client-bundle-secret-free.mjs . && node ../../scripts/assert-player-webos6-compatible.mjs .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@veyocast/config": "workspace:*",
    "@veyocast/content-templates": "workspace:*",
    "@veyocast/contracts": "workspace:*",
    "@supabase/supabase-js": "^2.110.7",
    "next": "^15.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6"
  }
}
