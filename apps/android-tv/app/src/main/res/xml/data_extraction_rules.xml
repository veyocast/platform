<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Device tokens and cached releases must never migrate to another physical screen. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
