    "editorial-shift": { "durationMs": 520, "easing": "cubic-bezier(.22,1,.36,1)", "translatePercent": 2.5 },
    "panel-reveal": { "durationMs": 560, "easing": "cubic-bezier(.16,1,.3,1)", "translatePercent": 0 }
  },
  "decorationRecipes": {
    "fieldflow-pitch": {
      "background": { "type": "linear-gradient", "angleDeg": 118, "accentStartPercent": 74, "accentMixLightPercent": 9, "accentMixDarkPercent": 13 },
      "grid": { "sizeCqw": 6, "lineCqw": 0.06, "opacity": 0.22, "maxVisualProminencePercent": 12 },
      "keyline": { "xCqw": 4.5, "widthCqw": 0.08 }
    },
    "editorial-rail": {
      "background": { "type": "linear-gradient", "angleDeg": 112, "accentStartPercent": 68, "accentMixLightPercent": 12, "accentMixDarkPercent": 17 },
      "keyline": { "xCqw": 4.4, "widthCqw": 0.08 }
    },
    "broadcast-grid-glass": {
      "radial": { "centerPercent": [82, 15], "accentMixLightPercent": 22, "accentMixDarkPercent": 28, "fadeEndLightPercent": 31, "fadeEndDarkPercent": 32 },
      "grid": { "sizeCqw": 5, "lineCqw": 0.08, "maskCenterPercent": [70, 50], "maskFadeEndPercent": 66 },
      "surfaceSheen": { "angleDeg": 145, "alpha": 0.07, "fadeEndPercent": 38 }
    },
    "atelier-linen": {
      "radial": { "centerPercent": [90, 100], "accentMixLightPercent": 14, "accentMixDarkPercent": 18, "fadeEndPercent": 38 },
      "stripe": { "angleDeg": 90, "stepCqw": 1.8, "lineCqw": 0.08, "opacity": 0.12 }
    },
    "velocity-lane": {
      "background": { "type": "linear-gradient", "angleDeg": 118, "accentStartPercent": 64, "accentEndPercent": 72, "accentMixLightPercent": 13, "accentMixDarkPercent": 20 },
      "lane": { "angleDeg": 118, "stepCqw": 8, "lineCqw": 0.15 },
      "titleSkewDeg": -5,
      "surfaceSkewDeg": -0.8
    },
    "heritage-pinstripe": {
      "stripe": { "angleDeg": 90, "stepCqw": 5, "lineCqw": 0.1, "lightAlpha": 0.04, "darkAlpha": 0.035 },
      "watermark": { "text": "1908", "rightCqw": 4.5, "bottomCqw": 2.8, "fontSizeCqw": 11, "fontWeight": 800, "lineHeight": 0.7 },
      "surfaceInset": { "widthCqw": 0.25, "accentMixPercent": 7 }
    },
    "stadium-halo": {
      "primaryRadial": { "centerPercent": [75, 42], "accentMixLightPercent": 32, "accentMixDarkPercent": 38, "fadeEndLightPercent": 27, "fadeEndDarkPercent": 28 },
      "supportRadial": { "centerPercent": [15, 90], "color": "#6960ff", "lightAlpha": 0.18, "darkAlpha": 0.24, "fadeEndLightPercent": 32, "fadeEndDarkPercent": 34 },
      "ring": { "sizeCqw": 30, "rightCqw": 6, "topCqw": 11, "borderCqw": 0.12, "accentMixPercent": 42, "staticGlowCqw": 3 }
    },
    "swiss-grid": {
      "accentRail": { "side": "left", "widthCqw": 1.2 },
      "gridColumnsPercent": [25, 50, 75],
      "gridLineCqw": 0.1,
      "surfaceBlur": false
    },
    "pavilion-polish": {
      "radial": { "centerPercent": [80, 10], "accentMixLightPercent": 22, "accentMixDarkPercent": 25, "fadeEndLightPercent": 34, "fadeEndDarkPercent": 35 },
      "surfaceInsetHighlight": { "widthCqw": 0.08, "color": "rgba(255,255,255,.18)" }
    },
    "tactical-coordinate-grid": {
      "radial": { "centerPercent": [82, 50], "accentMixLightPercent": 21, "accentMixDarkPercent": 25, "fadeEndLightPercent": 35, "fadeEndDarkPercent": 36 },
      "grid": { "sizeCqw": 4, "lineCqw": 0.08, "opacity": 0.58, "maxVisualProminencePercent": 20 },
