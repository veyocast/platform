  "manifestId": "veyocast-theme-catalog",
  "manifestVersion": "1.0.0",
  "status": "approved",
  "logicalCanvases": {
    "landscape": { "width": 1920, "height": 1080 },
    "portrait": { "width": 1080, "height": 1920 }
  },
  "shared": {
    "bodyFontRef": "vc-inter-v1",
    "baseDisplaySizeCqw": 4.75,
    "baseRadiusCqw": 2.1,
