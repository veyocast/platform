{
  "name": "@veyocast/content-templates",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./dynamic-template-view": {
      "types": "./dist/dynamic-template-view.d.ts",
      "default": "./src/dynamic-template-view.ts"
    },
    "./editorial-arena-theme": {
      "types": "./dist/editorial-arena-theme.d.ts",
      "default": "./src/editorial-arena-theme.ts"
    },
    "./royal-current-theme": {
      "types": "./dist/royal-current-theme.d.ts",
      "default": "./src/royal-current-theme.ts"
    },
    "./theme-catalog": {
      "types": "./dist/theme-catalog.d.ts",
      "default": "./src/theme-catalog.ts"
    },
    "./sites-presentation": {
      "types": "./dist/sites-presentation.d.ts",
      "default": "./src/sites-presentation.tsx"
    },
    "./sites-styles": {
      "types": "./dist/sites-styles.d.ts",
      "default": "./src/sites-styles.ts"
    },
    "./sites-v17-styles": {
      "types": "./dist/sites-v17-styles.d.ts",
      "default": "./src/sites-v17-styles.ts"
    },
    "./sites-media": {
      "types": "./dist/sites-media.d.ts",
      "default": "./src/sites-media.tsx"
    },
    "./sites-screen-themes": {
      "types": "./dist/sites-screen-themes.d.ts",
      "default": "./src/sites-screen-themes.ts"
    },
    "./sites-dynamic-projector": {
      "types": "./dist/sites-dynamic-projector.d.ts",
      "default": "./src/sites-dynamic-projector.ts"
    },
    "./sites-static-view": {
      "types": "./dist/sites-static-view.d.ts",
      "default": "./src/sites-static-view.tsx"
    },
    "./sites-presentation-model": {
      "types": "./dist/sites-presentation-model.d.ts",
      "default": "./src/sites-presentation-model.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@veyocast/contracts": "workspace:*",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "react": "19.2.7",
    "react-dom": "19.2.7"
