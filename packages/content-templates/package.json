{
  "name": "@veyocast/content-templates",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./dynamic-template-view": {
      "types": "./dist/dynamic-template-view.d.ts",
      "default": "./src/dynamic-template-view.ts"
    },
    "./editorial-arena-theme": {
      "types": "./dist/editorial-arena-theme.d.ts",
      "default": "./src/editorial-arena-theme.ts"
    },
    "./theme-catalog": {
      "types": "./dist/theme-catalog.d.ts",
      "default": "./src/theme-catalog.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@veyocast/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "react": "19.2.3",
    "react-dom": "19.2.7"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
