{
  "name": "@veyocast/studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./mobile-v3": {
      "types": "./src/mobile-v3.ts",
      "default": "./src/mobile-v3.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@veyocast/contracts": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@veyocast/content-templates": "workspace:*"
  }
}
