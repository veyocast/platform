# Voorbeeld voor handmatige stagingvalidatie. Echte waarden staan uitsluitend in
# het GitHub Environment en het mode-600 runtimebestand op de VPS.
COMPOSE_PROJECT_NAME=veyocast-staging
VEYOCAST_ENVIRONMENT=staging
CONTROL_HOST=staging-control.veyocast.nl
PLAYER_HOST=staging-player.veyocast.nl
CONTROL_BIND_PORT=13000
PLAYER_BIND_PORT=13001
DEPLOYMENT_SHA=replace-with-full-40-character-git-sha

NEXT_PUBLIC_SUPABASE_URL=https://replace-with-staging-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-staging-anon-jwt
SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-service-role-jwt

# Deze AES-key moet base64-gecodeerd 32 bytes zijn en voor dezelfde immutable
# build in staging en production gelijk zijn.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
DEVICE_LAB_ACCESS_TOKEN=replace-with-random-support-token
DEVICE_LAB_SESSION_SECRET=replace-with-random-32-byte-secret
