# Publieke hosts; DNS A/AAAA-records moeten naar de VPS wijzen.
CONTROL_HOST=control.example.nl
PLAYER_HOST=player.example.nl
ACME_EMAIL=beheer@example.nl

# Tag iedere deployment met de volledige Git-SHA.
DEPLOYMENT_SHA=replace-with-full-git-sha

# Supabase public clientconfiguratie. De anon-key is publiek, de service-role key niet.
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Minimaal 32 willekeurige bytes per secret; nooit committen buiten dit voorbeeld.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-random-32-byte-secret
DEVICE_LAB_ACCESS_TOKEN=replace-with-single-use-support-token
DEVICE_LAB_SESSION_SECRET=replace-with-random-32-byte-secret

# Optionele worker-tuning.
MEDIA_WORKER_ID=media-worker:production:1
MEDIA_WORKER_LOCK_TIMEOUT_SECONDS=900
MEDIA_WORKER_MAX_ATTEMPTS=3
MEDIA_WORKER_POLL_INTERVAL_MS=2000
