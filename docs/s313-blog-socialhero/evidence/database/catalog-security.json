  "storagePolicies": [
    {
      "policyname": "blog_storage_insert",
      "cmd": "INSERT",
      "roles": [
        "authenticated"
      ],
      "qual": null,
      "with_check": "((bucket_id = 'platform_blog_media'::text) AND ( SELECT private.blog_staff() AS blog_staff) AND (( SELECT private.current_aal() AS current_aal) = 'aal2'::text) AND (EXISTS ( SELECT 1\n   FROM platform_blog_assets a\n  WHERE ((a.storage_path = objects.name) AND (a.status = 'pending'::text)))))"
    },
    {
      "policyname": "blog_storage_select",
      "cmd": "SELECT",
      "roles": [
        "authenticated"
      ],
      "qual": "((bucket_id = 'platform_blog_media'::text) AND ( SELECT private.blog_staff() AS blog_staff) AND (EXISTS ( SELECT 1\n   FROM platform_blog_assets a\n  WHERE (a.storage_path = objects.name))))",
      "with_check": null
    }
  ],
