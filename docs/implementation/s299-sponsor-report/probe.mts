import { execFileSync } from "node:child_process";
import { createHash } from "node:crypto";
import { readFileSync, writeFileSync } from "node:fs";
import { resolve } from "node:path";
import assert from "node:assert/strict";
import { sponsorReportSchema } from "../../../packages/contracts/src/sponsor";
import { sponsorReportCsv } from "../../../apps/control/app/(shell)/dashboard/sponsors/sponsor-report";

// Local isolated database only; every source row is generated by the rollback
// fixture and accepted through the unmodified paired-device ingest RPC.
const root = process.cwd();
const testPath = resolve(root, "supabase/tests/rls_s299_sponsor_report.sql");
const test = readFileSync(testPath, "utf8");
const marker = "select is(pg_temp.s299_report()#>>'{totals,acceptedEvents}','5501'";
assert(test.includes(marker));
const setup = test.slice(0, test.indexOf(marker));
const query = setup + `
select public.set_sponsor_report_goal_v1('10000000-0000-4000-8000-000000001151',
 (select (info->>'campaign1')::uuid from s299_fixture where tenant_id='10000000-0000-4000-8000-000000001151'),
 current_setting('s299.from')::date,current_setting('s299.until')::date,6000);
select jsonb_build_object('s299Proof',jsonb_build_object(
 'unfiltered',pg_temp.s299_report(),
 'campaignOnly',pg_temp.s299_report((select (info->>'campaign1')::uuid from s299_fixture where tenant_id='10000000-0000-4000-8000-000000001151')),
 'screenOnly',pg_temp.s299_report(null,'30000000-0000-4000-8000-000000001152'),
 'intersection',pg_temp.s299_report((select (info->>'campaign1')::uuid from s299_fixture where tenant_id='10000000-0000-4000-8000-000000001151'),'30000000-0000-4000-8000-000000001152'),
 'page2',pg_temp.s299_report(null,null,null,(pg_temp.s299_report()#>>'{details,49,happenedAt}')::timestamptz,(pg_temp.s299_report()#>>'{details,49,eventId}')::uuid)
));
rollback;
`;
const output = execFileSync("psql", ["-X", "-A", "-t", "-q", "-h", "127.0.0.1", "-p", "64432", "-U", "postgres", "-d", "postgres", "-v", "ON_ERROR_STOP=1"], {
  input: query, encoding: "utf8", env: { ...process.env, PGPASSWORD: "postgres" }, maxBuffer: 4 * 1024 * 1024
});
const line = output.split("\n").find(value => value.startsWith('{"s299Proof"'));
assert(line, "missing report proof from the local rollback transaction");
const captured = JSON.parse(line).s299Proof as Record<string, unknown>;
const reports = Object.fromEntries(Object.entries(captured).map(([name, value]) => [name, sponsorReportSchema.parse(value)]));
assert.equal(reports.unfiltered!.totals.acceptedEvents, "5501");
assert.equal(reports.unfiltered!.totals.playedMs, "5509251");
assert.equal(reports.campaignOnly!.totals.acceptedEvents, "2751");
assert.equal(reports.screenOnly!.totals.acceptedEvents, "1833");
assert.equal(reports.intersection!.totals.acceptedEvents, "917");
assert.equal(reports.unfiltered!.goals[0]!.targetPlays, "6000");
assert.deepEqual(reports.page2!.totals, reports.unfiltered!.totals);
assert.equal(reports.unfiltered!.details.length, 50);
assert.equal(reports.page2!.details.length, 50);
const ids = new Set(reports.unfiltered!.details.map(row => row.eventId));
assert(reports.page2!.details.every(row => !ids.has(row.eventId)));
for (const report of Object.values(reports)) {
  assert.equal(report.groups.reduce((sum, group) => sum + BigInt(group.acceptedEvents), 0n).toString(), report.totals.acceptedEvents);
  assert.equal(report.groups.reduce((sum, group) => sum + BigInt(group.playedMs), 0n).toString(), report.totals.playedMs);
}
const csv = sponsorReportCsv(reports.unfiltered!);
assert(csv.includes('"Totaal";"";"";"5501";"5509251"'));
assert(!/device_id|token_hash|context_json|encrypted/iu.test(csv));
const fixturePath = resolve(root, "tests/fixtures/s299-sponsor-report-source.json");
const evidencePath = resolve(root, "docs/implementation/s299-sponsor-report");
writeFileSync(fixturePath, JSON.stringify(reports, null, 2) + "\n");
writeFileSync(resolve(evidencePath, "actual-database-report.csv"), csv);
const proof = {
  schemaVersion: 1, evidenceKind: "isolated-database-real-ingest-and-rpc", database: { host: "127.0.0.1", port: 64432, rolledBack: true },
  asOf: reports.unfiltered!.asOf, timezone: reports.unfiltered!.timezone, period: reports.unfiltered!.period,
  assertions: { acceptedEvents: "5501", playedMs: "5509251", campaign: "2751", screen: "1833", intersection: "917", targetPlays: "6000", detailsPerPage: 50, cursorOverlap: 0, groupTotalsEqual: true, csvTotalsEqual: true },
  csvSha256: createHash("sha256").update(csv).digest("hex"),
  fixtureSha256: createHash("sha256").update(readFileSync(fixturePath)).digest("hex"),
  testSha256: createHash("sha256").update(test).digest("hex"),
  limitations: ["Generated isolated data; no customer telemetry", "CSV uses aggregate rows; detail pagination stays independent", "Cutoff freezes receipts, not mutable names or agreement metadata", "Browser uses these captured RPC answers over controlled HTTP, not a hosted deployment"]
};
writeFileSync(resolve(evidencePath, "database-proof.json"), JSON.stringify(proof, null, 2) + "\n");
process.stdout.write(JSON.stringify(proof, null, 2) + "\n");
