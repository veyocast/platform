import {writeFileSync} from 'node:fs';
import {fileURLToPath} from 'node:url';
import {createRequire} from 'node:module';
import {join} from 'node:path';
import {syncDynamicConfigurationSchema} from '../packages/contracts/src/sync-dynamic-configuration';
const root=fileURLToPath(new URL('../',import.meta.url)),require=createRequire(join(root,'packages/contracts/package.json'));
const {z}=require('zod') as typeof import('../packages/contracts/node_modules/zod');
const schema=z.toJSONSchema(syncDynamicConfigurationSchema,{target:'draft-7',io:'output'});
writeFileSync(join(root,'packages/contracts/src/sync-dynamic-json-schema.json'),JSON.stringify(schema,null,2)+'\n');
console.log('Generated current Source configuration JSON only; historical SQL is never a generator output.');
